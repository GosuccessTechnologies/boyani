model WebPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String   @default("")  // rich text (tiptap HTML)
  heroDesignId Int     @default(1)
  breadcrumbDesignId Int @default(1)
  seoTitle    String   @default("")
  seoDescription String @default("")
