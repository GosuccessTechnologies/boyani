// ─────────────────────────────────────────────────────────────
// CALLS  (received & made within the facility)
// ─────────────────────────────────────────────────────────────

model CallRecord {
  id          String   @id @default(cuid())
  direction   String   @default("IN")      // IN | OUT | MISSED
  callerName  String   @default("")
  callerPhone String
  regarding   String   @default("")      // patient / department / general
  category    String   @default("GENERAL") // GENERAL | APPOINTMENT | INQUIRY | COMPLAINT | FOLLOWUP | EMERGENCY
  durationSec Int      @default(0)
  notes       String   @default("")       // tiptap HTML or plain
  handledById String   @default("")
  callTime    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([direction])
  @@index([callTime])
  @@index([callerPhone])
}
