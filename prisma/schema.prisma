// Public doctor directory (linked to Employee/User)
model DoctorProfile {
  id          String   @id @default(cuid())
  employeeId  String   @default("")
  name        String
  title       String   @default("Dr.")
  specialization String @default("General Practitioner")
  department  String   @default("")
  qualifications String @default("")
  bio         String   @default("")
  photoUrl    String   @default("")
