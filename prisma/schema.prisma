  provider    String   @default("smtp")
  providerRef String   @default("")
  sentById    String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PARCELS  (receiving & dispatch)
// ─────────────────────────────────────────────────────────────

model ParcelRecord {
  id            String   @id @default(cuid())
  trackingCode  String   @unique
