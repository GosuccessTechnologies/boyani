// ─────────────────────────────────────────────────────────────
// THEMES  (adapted from politicsmigori platform — 10 seeded)
// ─────────────────────────────────────────────────────────────

model Theme {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
