  primary        String   @default("#0d9488")
  secondary      String   @default("#f59e0b")
  tertiary       String   @default("#0891b2")
  fontBody       String   @default("Inter")
  fontHeading    String   @default("Inter")
  headingFormat  String   @default("normal")
  bgBody         String   @default("#FFFFFF")
  bgCard         String   @default("#F8FAFC")
  bgSidebar      String   @default("#0f172a")
  bgHeader       String   @default("#FFFFFF")
  bgFooter       String   @default("#0f172a")
  bgCardHeader   String   @default("#134e4a")
  textPrimary    String   @default("#0f172a")
  textSecondary  String   @default("#475569")
  textMuted      String   @default("#94a3b8")
  dividerColor   String   @default("#E2E8F0")
  scrollbarColor String   @default("#CBD5E1")
  scrollbarTrack String   @default("#F1F5F9")
  bodyFormat     String   @default("full-width") // full-width | boxed
